#!/usr/bin/env bash

##	- Purpose: Run the correctness gate before a push reaches main, so nothing
##	  gets there unverified even outside a full cicd run.
##	- Nothing else waits, dev included. Everyday work would otherwise spend ten
##	  minutes per push re-running what the branch was already built and tested
##	  against, and dev is where work collects rather than where it has to be
##	  right. Build and test before merging; the gate is the last check, not the
##	  only one.
##	- The gate runs on the commit being pushed, checked out into a throwaway
##	  worktree, not on the working tree: an uncommitted fix must not pass a
##	  broken commit, and an uncommitted breakage must not block a good one.
##	- The worktree builds into its own persistent cargo target dir
##	  (source/rust/target-gate in the checkout, gitignored), linked in as
##	  source/rust/target so the config's relative binary paths still resolve.
##	  cargo recompiles the crate every run regardless - the fingerprint keys on
##	  the package path, which is a fresh mktemp dir each time - so sharing the
##	  checkout's own target dir saved nothing and did harm: the test binaries
##	  bake CARGO_MANIFEST_DIR and were left pointing at a worktree that no
##	  longer existed, and the checkout's debug binary was overwritten by the
##	  pushed commit's build.
##	- If git cannot create a worktree, the gate runs in place with a warning.
##	- A commit whose tree a gate already passed goes out without running it
##	  again. cicd.bash records each tree it passes (utility/green-tree.bash),
##	  the run this hook starts included, so a full run's own publish push, a
##	  --no-ff merge of a branch that passed, and a retry after a dropped
##	  connection all go straight through. SHCL_GATE_RERUN=1 runs it anyway.
##	- A push to main whose version has reached the tag the banner's Syntax link
##	  names has to find that tag on the remote, or send it in the same push
##	  (utility/check-banner-tag.bash). That check runs even when the gate is
##	  skipped.
##	- The large-document stage is left out here (minutes; a full local run and
##	  the hosted workflow on main run it); this is the fast correctness half.
##	- Escape hatch: `git push --no-verify`, or SHCL_SKIP_HOOK=1.
##	- Installed by pointing git at this directory:
##		git config core.hooksPath cicd/hooks
##	- git opens the ssh session before this hook runs and sends only after it
##	  returns. The gate takes minutes, GitHub drops an idle session, and the
##	  push then dies of SIGPIPE (exit 141) right after a green gate. Keepalives
##	  keep the session up; install-dev.bash sets them when nothing is set:
##		git config core.sshCommand "ssh -o ServerAliveInterval=30 -o ServerAliveCountMax=30"

##	Copyright © 2026 Jim Collier [ID: 2უNაɘ«҂թȹɤξπ๙¿ձϖ]
##	Licensed under The MIT License (MIT). Full text at:
##		https://mit-license.org/
##	SPDX-License-Identifier: MIT

set -Eeuo pipefail

[[ -n "${SHCL_SKIP_HOOK:-}" ]] && exit 0

## A push from a linked worktree hands the hook GIT_DIR and friends. Passed on,
## every scratch repo a gate builds with `git -C` or `git init` acts on this
## one instead: commits on the branch, core.bare set, sshCommand replaced.
for gitVar in $(git rev-parse --local-env-vars 2>/dev/null || true); do unset "${gitVar}"; done

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "${here}/../.." && pwd)"

## stdin gives "<local ref> <local sha> <remote ref> <remote sha>" per ref.
## Only a push that would move main is worth the wait; the sha bound for it is
## what gets tested. All zeros means a delete: nothing to test. One push names
## main at most once, so this collects a single sha, and the loop stays general
## in case another branch is gated again. Tag refs are collected for the banner
## tag check. Collected inside the loop: the read that ends it clears the vars.
gatedShas=(); gatedRefs=(); pushedTags=()
while read -r _localRef localSha remoteRef _remoteSha; do
	case "${remoteRef}" in
		refs/tags/*) pushedTags+=("${remoteRef}=${localSha}") ;;
		refs/heads/main)
			[[ "${localSha}" =~ ^0+$ ]] && continue
			refName="${remoteRef#refs/heads/}"; seen=0
			for i in "${!gatedShas[@]}"; do
				[[ "${gatedShas[i]}" == "${localSha}" ]] || continue
				gatedRefs[i]="${gatedRefs[i]} + ${refName}"; seen=1
			done
			((seen)) || { gatedShas+=("${localSha}"); gatedRefs+=("${refName}"); } ;;
	esac
done
((${#gatedShas[@]})) || exit 0

## A detached worktree at the pushed commit, removed once its gate is through so
## the next sha (if any) starts clean.
tmpTree=""; treeAdded=0
# shellcheck disable=SC2329  # runs from the EXIT trap as well
fCleanup(){
	[[ -n "${tmpTree}" ]] || return 0
	if ((treeAdded)); then git -C "${root}" worktree remove --force "${tmpTree}" >/dev/null 2>&1 || true; fi
	rm -rf "${tmpTree}"
	git -C "${root}" worktree prune >/dev/null 2>&1 || true
	tmpTree=""; treeAdded=0
}
trap fCleanup EXIT

for i in "${!gatedShas[@]}"; do
	sha="${gatedShas[i]}"
	## Ahead of the skip below, since a tree that passed the gate on dev never
	## asked about tags.
	if ! "${root}/cicd/utility/check-banner-tag.bash" "${1:-origin}" "${sha}" ${pushedTags[@]+"${pushedTags[@]}"}; then
		echo
		echo "[ pre-push: the tag the banner's Syntax link names will not be on ${1:-origin} - push refused (--no-verify overrides) ]" >&2
		echo
		exit 1
	fi
	## A failed lookup, or a checkout with no helper, reads as not passed.
	tree="$(git -C "${root}" rev-parse -q --verify "${sha}^{tree}" || true)"
	if [[ -n "${tree}" && -z "${SHCL_GATE_RERUN:-}" ]] && "${root}/cicd/utility/green-tree.bash" passed "${root}" "${tree}"; then
		## The one thing the gate reads from outside the tree is dev's
		## installers, which it compares against a push to main. The run that
		## recorded the tree may have stood in for another ref, so that one
		## comparison is made here, on the tree being pushed (20260926 item 13).
		drifted=""
		if [[ "${gatedRefs[i]}" == main ]] && git -C "${root}" rev-parse -q --verify origin/dev >/dev/null; then
			drifted="$(git -C "${root}" diff --name-only origin/dev "${sha}" -- install.bash install.ps1 install-dev.bash || true)"
		fi
		if [[ -z "${drifted}" ]]; then
			echo
			echo "[ pre-push: ${sha:0:12} has the same files as a run that passed the gate; not running it again ]"
			echo
			continue
		fi
		echo
		echo "[ pre-push: ${sha:0:12} passed a gate, but its installers differ from dev's, which that run did not judge for main ]"
	fi
	echo
	echo "[ pre-push: running the correctness gate on ${sha:0:12} before ${gatedRefs[i]} ]"
	echo
	tmpTree="$(mktemp -d "${TMPDIR:-/tmp}/shcl-prepush.XXXXXX")"
	if git -C "${root}" worktree add --detach "${tmpTree}" "${sha}" >/dev/null 2>&1; then
		treeAdded=1
		gateRoot="${tmpTree}"
		mkdir -p "${root}/source/rust/target-gate"
		ln -s "${root}/source/rust/target-gate" "${tmpTree}/source/rust/target"
	else
		echo "[ pre-push: WARNING: could not check ${sha:0:12} out into a worktree; gating the working tree instead ]" >&2
		gateRoot="${root}"
	fi
	## The gate is told which ref it stands in for: the installer drift check
	## has to judge this tree as main, since git moves origin/main only after
	## the hook returns.
	if ! SHCL_GATE_REF="${gatedRefs[i]}" "${gateRoot}/cicd/cicd.bash" --ci --no-largedoc; then
		echo
		echo "[ pre-push: the gate failed on ${sha:0:12} - push refused (--no-verify overrides) ]" >&2
		echo
		exit 1
	fi
	fCleanup
done
exit 0
