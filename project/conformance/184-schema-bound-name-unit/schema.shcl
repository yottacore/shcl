field: hold-ms
	type: duration
	min: 100
	max: 2000
field: idle-ms
	type: duration
	min: 100
field: wait-seconds
	type: duration
	unit: ms
	min: 2
field: ttl-hours
	type: duration
	min: 30m
field: cache_mb
	type: size
	min: 1
	max: 1.5
field: limit-kb
	type: size
	decimal: yes
	max: 2
field: pool
	type: duration
	min: 5
field: slots.*
	type: duration
	max: 10
