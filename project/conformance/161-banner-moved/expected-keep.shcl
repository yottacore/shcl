# Info blocks that were in the footer until fields were added below them
# by hand. banner takes them off wherever they sit after the first field.
# A comment nested under a block moves out to the column the block was at.
a:
	b: 1
c: 1
e:

	# a note of the file's own
	f: 1
# a note under the old footer block

