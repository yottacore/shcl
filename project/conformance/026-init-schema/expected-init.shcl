## Port the server listens on.
## int, 1-65535, required
server.port: 8080

## Request timeout in seconds.
## float, >= 0.5
# server.timeout:

## Hostname per server.
## string, required
server.host:

## Log verbosity.
## string, one of: debug, info, warn
# log.level: info

## Enabled feature flags.
## string-array
# features:

## int, repeat 1-5
replicas:

## float, 811212085039910.2-1125899906842624.2
# ratio:

## float, one of: 811212085039910.2, 1125899906842624.2
# scale:

## int, one of: 3, 7, 1-9
# tier: 3

## float, one of: 0.5, 1.5, >= 0.5
# gain:

