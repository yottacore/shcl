# Schema for the init generator. `desc`/`default` are generator-only vocabulary.
field: server.port
	type: int
	required: yes
	min: 1
	max: 65535
	desc: "Port the server listens on."
	default: 8080

field: log.level
	type: string
	allowed: [debug, info, warn]
	desc: "Log verbosity."
	default: info

field: server.timeout
	type: float
	min: 0.5
	desc: "Request timeout in seconds."

field: features
	type: string-array
	desc: "Enabled feature flags."

field: "server[*].host"
	type: string
	required: yes
	desc: "Hostname per server."

field: replicas
	type: int
	repeat: [1, 5]

field: ratio
	type: float
	min: 811212085039910.2
	max: 1125899906842624.2

field: scale
	type: float
	allowed: [811212085039910.2, 1125899906842624.2]

# Both keys on one field: `allowed` and the bounds are separate parts of the
# annotation line, and the validator enforces both.
field: tier
	type: int
	min: 1
	max: 9
	allowed: [3, 7]
	default: 3

field: gain
	type: float
	min: 0.5
	allowed: [0.5, 1.5]
