# A line refused for its value alone binds nothing, and what is written
# under it still loads, under the field with no value.
wallpaper: "C:\Users\x.png"
	rotate:
		enabled: false
	opacity: 0.2
ports: [80, 443] # kept
	tls: on
path: "C:\temp"
	* one
	* two
nested: "\q"
	inner: [x]
		deep: 1
sel[web]: "\q"
	port: 8
empty: "\q"
"bad\q": 1
	gone: 1
last: 1
