field: title
	type: string
	meta: [t, name]
	required: yes
field: launched
	type: datetime
field: server
	repeat: [1, 4]
field: "server(*).port"
	type: int
	required: yes
	min: 1
	max: 65535
field: "server(*).host"
	type: string
	required: yes
field: "server(*).region"
	type: string-array
field: "server(*).region"
	allowed: [us, eu, apac]
field: timeouts
	type: int-array
	min: 1
	max: 600
field: motd
	type: raw
field: debug
	type: bool
	meta: dbg
		aliases: [verbose, trace]
		field: nothing
			type: nope
field: meta
	type: string
