# A kept element holds its column the way a dropped one does, with the field as
# that level's node. A field line under the elements, written deeper or back
# at their column, is kept and binds nothing (E001), and the elements after it
# still join the list.
a:
	- x
	d: 2
	- y
	c: 1
b: 2
list:
	- one
	- two
	- three
	deep: 3
after: 4
