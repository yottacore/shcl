# A kept element holds its column the way a dropped one does, with the field as
# that level's node. A field written deeper binds under the field (E001), and a
# line back at the element's column is its sibling: the next field binds, and
# an element after a field child is E008.
a:
	- x
	c: 1
	d: 2
b: 2
list:
	- one
	- two
	deep: 3
after: 4
