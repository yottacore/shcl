# Loose reads a quoted thousands number. Bare is text, and so is a
# comma that breaks the grouping.
a: "1,200"
b: "$1,200"
c: "1,200.50"
d: 1,200
e: "1, 200"
f: "1,2,3"
g: '-12,345,678'
h: "1,200%"
i: $1,200.50
j: "1,200."
k: "$1,200.%"
m: 1,200.
n: ".1,200"
items:
	- 80,443
	- "2,500"
arr: ["1,000", "€3,000.25"]
