## string, required
srv: web

## int, repeat 1
srv(web).port:

## string, required
srv(web).host: "a b"

## string, required
srv(web).host("a b").zone:

## string
# opt: x

## int, required
opt.child:

## string, required
odd: "a]b"

## int, required
odd("a]b").under:

## string, required
bare:

## int, required
bare.leaf:

